;
; SamaIddDriver.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=SamaIddDriver.cat
DriverVer=11/03/2026,0.1.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
%DeviceName%=MyDevice_Install, Root\SamaIddDriver
%DeviceName%=MyDevice_Install, SamaIddDriver

[SourceDisksFiles]
SamaIddDriver.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
; Local SYSTEM and administrators only; desktop frames are not public.
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "SamaIddDriverGroup"

[MyDevice_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MyDevice_Install.NT.Wdf]
UmdfService=SamaIddDriver,SamaIddDriver_Install
UmdfServiceOrder=SamaIddDriver
UmdfKernelModeClientPolicy = AllowKernelModeClients

[SamaIddDriver_Install]
UmdfLibraryVersion=2.25.0
ServiceBinary=%12%\UMDF\SamaIddDriver.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
SamaIddDriver.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="SAMA USB Display Contributors"
DiskName = "SamaIddDriver Installation Disk"
DeviceName="SAMA USB Portrait Display"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
